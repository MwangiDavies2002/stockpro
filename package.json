{
  "name": "stockpro-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build:renderer": "npm --prefix bar-inventory-system run build:desktop",
    "start": "npm run build:renderer && electron .",
    "dist:win": "npm run build:renderer && electron-builder --win nsis",
    "migrate:json": "node scripts/migrate-json-to-sqlite.js",
    "test:offline": "node scripts/offline-smoke-test.js"
  },
  "devDependencies": { "electron": "^35.0.0", "electron-builder": "^26.0.0" },
  "dependencies": { "better-sqlite3": "^11.8.1" },
  "build": { "appId": "com.stockpro.pos", "productName": "StockPro", "files": ["electron/**/*", "bar-inventory-system/out/**/*", "package.json"], "win": { "target": "nsis" }, "nsis": { "oneClick": false, "perMachine": false } }
}
