                .pmpro-seat-slider::-moz-range-track { width: 100%; height: 8px; cursor: pointer; background: #ED455D; border-radius: 4px; }
                .pmpro-seat-slider::-webkit-slider-thumb { height: 22px; width: 22px; border-radius: 50%; background: #f0647a; cursor: pointer; -webkit-appearance: none; margin-top: -7px; box-shadow: 0 2px 5px rgba(0,0,0,0.3); transition: transform 0.1s; }
                .pmpro-seat-slider::-webkit-slider-thumb:active { transform: scale(1.1); }
                .pmpro-seat-slider::-moz-range-thumb { height: 22px; width: 22px; border-radius: 50%; background: #f0647a; cursor: pointer; border: none; box-shadow: 0 2px 5px rgba(0,0,0,0.3); }
            </style>

            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    const wrappers = document.querySelectorAll('.pmpro-seat-calc-wrapper');
                    
                    wrappers.forEach(wrapper => {
                        const slider = wrapper.querySelector('.pmpro-seat-slider');
                        const seatDisplay = wrapper.querySelector('.seat-count-display');
                        const priceDisplay = wrapper.querySelector('.price-display');
                        
                        const basePrice = parseFloat(wrapper.getAttribute('data-base-price')) || 0;
                        const seatPrice = parseFloat(wrapper.getAttribute('data-seat-price')) || 0;
                        const includedSeats = parseInt(wrapper.getAttribute('data-included-seats')) || 0;
                        const currency = wrapper.getAttribute('data-currency');
                        const targetId = wrapper.getAttribute('data-target-id');
                        const checkoutBaseUrl = wrapper.getAttribute('data-checkout-url');
                        
                        // Target the wrapper ID, then find the Breakdance link inside it
                        const targetWrapper = document.getElementById(targetId);
                        let targetBtn = null;
                        
                        if (targetWrapper) {
                            targetBtn = targetWrapper.querySelector('.breakdance-link');
                            // Fallback in case the ID was applied directly to the anchor link instead of a wrapper
                            if (!targetBtn && targetWrapper.tagName.toLowerCase() === 'a') {
                                targetBtn = targetWrapper;
                            }
                        }

                        function updateCalculator() {
                            const totalSeats = parseInt(slider.value) || 0;
                            const extraSeats = Math.max(0, totalSeats - includedSeats);
                            const total = (basePrice + (extraSeats * seatPrice)).toFixed(2);
                            
                            seatDisplay.textContent = totalSeats;
                            priceDisplay.textContent = currency + total;
                            
                            if (targetBtn) {
                                const separator = checkoutBaseUrl.includes('?') ? '&' : '?';
                                targetBtn.href = checkoutBaseUrl + separator + 'pmpro_group_seats=' + totalSeats; 
                            }
                        }

                        slider.addEventListener('input', updateCalculator);
                        updateCalculator();
                    });
                });
            </script>
        </div>
        
        </div>
