# Configure these in the Vercel API project; never commit the real .env file.
NODE_ENV=production
DB_HOST=your-managed-mysql-host
DB_PORT=3306
DB_NAME=barstockpro
DB_USER=app_user
DB_PASSWORD=replace-with-a-strong-password
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Comma-separated production frontend domains. Include the https:// scheme.
FRONTEND_URL=https://your-app.vercel.app
